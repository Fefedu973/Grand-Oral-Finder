{
  "name": "grand-oral-finder",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.6.7",
      "typescript": "^6.0.3",
      "@types/bun": "^1.4.4",
      "hono": "^4.13.16",
      "@orpc/server": "^1.16.1",
      "@orpc/openapi": "^1.16.1",
      "@orpc/zod": "^1.16.1",
      "lucide-react": "^1.66.0",
      "next-themes": "^0.4.6",
      "react": "^19.3.1",
      "react-dom": "^19.3.1",
      "sonner": "^2.0.8",
      "@orpc/client": "^1.16.1",
      "@tailwindcss/postcss": "^4.3.4",
      "@types/react": "^19.3.0",
      "@types/react-dom": "^19.3.0",
      "tailwindcss": "^4.3.4"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "bun test",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:push": "bun --cwd packages/db db:push",
    "db:studio": "bun --cwd packages/db db:studio",
    "db:generate": "bun --cwd packages/db db:generate",
    "db:migrate": "bun --cwd packages/db db:migrate",
    "db:seed:test": "bun --cwd apps/server seed:test",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "check": "biome check --write ."
  },
  "dependencies": {
    "@grand-oral-finder/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@grand-oral-finder/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.11.10",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "overrides": {
    "minimatch": "11.0.4",
    "@hono/node-server": "2.1.6",
    "esbuild": "0.28.2"
  }
}
